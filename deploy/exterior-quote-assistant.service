[Unit]
Description=Exterior Quote Assistant Streamlit App
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/exterior-quote-assistant
EnvironmentFile=-/opt/exterior-quote-assistant/.env
ExecStart=/opt/exterior-quote-assistant/.venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --server.baseUrlPath quote-system --browser.gatherUsageStats false
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
